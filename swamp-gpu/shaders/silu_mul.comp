#version 460

// SiLU activation: out = gate * sigmoid(gate) * up
// Applied element-wise

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    int n;
} pc;

layout(set = 0, binding = 0) buffer GateBuf { float gate[]; };
layout(set = 0, binding = 1) buffer UpBuf { float up[]; };
layout(set = 0, binding = 2) buffer OutBuf { float out[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= uint(pc.n)) return;

    float g = gate[gid];
    // SiLU: x * sigmoid(x)
    float sig = 1.0 / (1.0 + exp(-g));
    out[gid] = g * sig * up[gid];
}
